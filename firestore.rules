rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================================================================
    // AUTORIZAÇÃO DE ADMINISTRADOR:
    // Baseada em registo na coleção /admins/{uid} ou claims de autenticação,
    // eliminando dependência estática de emails em código nas regras de segurança.
    // ==============================================================================

    // Default Deny All root fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['role']) && (request.auth.token.role == 'admin' || request.auth.token.role == 'Administrador')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isApprovedUser() {
      return isAuthenticated() && (
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account.status == 'approved')
      );
    }

    /**
     * Retrieves the clubId assigned to the authenticated user from their user account document.
     */
    function getUserClubId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account.keys().hasAny(['clubId'])
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account.clubId
             : null;
    }

    /**
     * Retrieves the user account object for the authenticated user.
     */
    function getUserAccount() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account
        : null;
    }

    /**
     * Retrieves the list of assigned team IDs for the authenticated user.
     */
    function getUserAssignedTeams() {
      let acc = getUserAccount();
      return (acc != null && acc.keys().hasAny(['assignedTeams']) && acc.assignedTeams is list)
        ? acc.assignedTeams
        : [];
    }

    /**
     * Enforces strict team-level multi-tenant isolation:
     * A coach can ONLY read and write data belonging to the specific team workspace(s) assigned to them.
     * Administrators have global access to all team workspaces.
     */
    function canAccessTeamWorkspace(workspaceId) {
      return isAuthenticated() && (
        isMasterAdmin() || 
        (isApprovedUser() && (
          (getUserAssignedTeams().hasAny([workspaceId, 'all'])) &&
          (resource == null || !resource.data.keys().hasAny(['clubId']) || resource.data.clubId == getUserClubId() || getUserClubId() == null)
        ))
      );
    }

    /**
     * Verifies if the authenticated user is an approved member of the specific team.
     * Administrators have unrestricted access.
     * Regular members must have teamId in assignedTeams (or 'all') and match clubId.
     */
    function isTeamMember(teamId) {
      return isAuthenticated() && (
        isMasterAdmin() || 
        (isApprovedUser() && (
          getUserAssignedTeams().hasAny([teamId, 'all'])
        ) && (
          resource == null || !resource.data.keys().hasAny(['clubId']) || resource.data.clubId == getUserClubId() || getUserClubId() == null
        ))
      );
    }

    /**
     * Verifies if the authenticated user has edit privileges on the team database:
     * Allowed: Administrador, Treinador Principal, Treinador Adjunto.
     */
    function canEditTeamDatabase(teamId) {
      let acc = getUserAccount();
      return isAuthenticated() && (
        isMasterAdmin() ||
        (isTeamMember(teamId) && acc != null && (
          acc.role in ['Administrador', 'Treinador Principal', 'Treinador Adjunto']
        ))
      );
    }

    /**
     * Validates team database root metadata
     */
    function isValidTeamDbMeta(data) {
      return data is map &&
        data.size() <= 10 &&
        data.keys().hasAll(['clubId', 'name', 'createdBy', 'updatedAt']) &&
        data.clubId is string && data.clubId.size() <= 64 &&
        data.name is string && data.name.size() <= 100 &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 100)) &&
        data.updatedAt is number && data.updatedAt >= 0 &&
        data.updatedAt <= (request.time.toMillis() + 600000);
    }

    /**
     * Validates dataset metadata (columns <= 40, rowCount <= 5000, strings <= 500)
     */
    function isValidTeamDataset(data) {
      return data is map &&
        data.size() <= 10 &&
        data.keys().hasAll(['name', 'columns', 'rowCount', 'version', 'updatedAt', 'updatedBy']) &&
        data.name is string && data.name.size() <= 100 &&
        data.columns is list && data.columns.size() <= 40 &&
        data.rowCount is number && data.rowCount >= 0 && data.rowCount <= 5000 &&
        data.version is number &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        data.updatedAt is number && data.updatedAt >= 0 &&
        data.updatedAt <= (request.time.toMillis() + 600000);
    }

    /**
     * Validates individual row data in subcollection
     */
    function isValidTeamDbRow(data) {
      return data is map &&
        data.size() <= 10 &&
        data.keys().hasAll(['data', 'order', 'updatedAt', 'updatedBy']) &&
        data.data is map && data.data.size() <= 40 &&
        data.order is number &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        data.updatedAt is number && data.updatedAt >= 0 &&
        data.updatedAt <= (request.time.toMillis() + 600000);
    }

    /**
     * Enforces strict multi-club tenant isolation:
     * A coach or staff user can ONLY read and write data belonging to their own club workspace.
     */
    // ---- F1.3: organizations and members (rules v2 "compatible") ----
    // organizations/{orgId}/members/{uid} becomes the source of truth of access. These rules ADD access for active
    // members of an approved (active) organization, and KEEP the old access (clubId and the "main" fallback)
    // until the migration of "main" is done and checked (the strict rules v3 come later, in F1.10).

    function orgMemberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function isActiveOrgMember(orgId) {
      return isAuthenticated() &&
        exists(orgMemberPath(orgId, request.auth.uid)) &&
        get(orgMemberPath(orgId, request.auth.uid)).data.status == 'active' &&
        exists(orgPath(orgId)) &&
        // Only APPROVED organizations give access: a pending one (waiting for the platform's manual approval) or a
        // suspended one gives none, so nobody gets in by creating an organization themselves
        get(orgPath(orgId)).data.status == 'active';
    }

    function myOrgRole(orgId) {
      return get(orgMemberPath(orgId, request.auth.uid)).data.role;
    }

    function roleRank(role) {
      return {'owner': 7, 'admin': 6, 'diretor': 5, 'coordenador': 4, 'treinador': 3, 'adjunto': 2, 'staff': 1}[role];
    }

    /** Owner or admin of the organization: they manage the members. */
    function isOrgManager(orgId) {
      return isActiveOrgMember(orgId) && myOrgRole(orgId) in ['owner', 'admin'];
    }

    function isValidOrganization(orgId, data) {
      return data is map &&
        data.keys().hasAll(['id', 'type', 'name', 'status', 'ownerUid', 'createdAt', 'createdBy', 'plan']) &&
        data.keys().hasOnly(['id', 'type', 'name', 'shortName', 'logoUrl', 'status', 'ownerUid', 'createdAt', 'createdBy', 'plan']) &&
        data.id == orgId && isValidId(orgId) &&
        data.type in ['individual', 'club'] &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!data.keys().hasAny(['shortName']) || (data.shortName is string && data.shortName.size() <= 40)) &&
        (!data.keys().hasAny(['logoUrl']) || (data.logoUrl is string && data.logoUrl.size() <= 2048)) &&
        data.status in ['pending', 'active', 'suspended'] &&
        isValidId(data.ownerUid) && isValidId(data.createdBy) &&
        data.createdAt is number && data.plan == null;
    }

    function isValidOrgMember(uid, data) {
      return data is map &&
        data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'teamIds', 'status', 'addedBy', 'addedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'teamIds', 'status', 'addedBy', 'addedAt', 'revokedAt', 'revokedBy']) &&
        data.uid == uid &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() <= 254 &&
        data.role in ['owner', 'admin', 'diretor', 'coordenador', 'treinador', 'adjunto', 'staff'] &&
        data.teamIds is list && data.teamIds.size() > 0 && data.teamIds.size() <= 50 &&
        data.status in ['active', 'suspended', 'revoked'] &&
        isValidId(data.addedBy) && data.addedAt is number;
    }

    // ---- F2.3: per team and per role (rules v3a) ----
    // A person with a membership in the organization (any status) is governed ONLY by it: their teams and role.
    // Who has no membership yet keeps the old access (club or "main") until the strict rules v3 (F1.10).

    function hasOrgMembership(orgId) {
      return isAuthenticated() && exists(orgMemberPath(orgId, request.auth.uid));
    }

    function myOrgTeams(orgId) {
      return get(orgMemberPath(orgId, request.auth.uid)).data.teamIds;
    }

    /** An active member sees the club record ('_club') and the teams of their membership ('*' = every team). */
    function memberSeesTeam(orgId, teamId) {
      return isActiveOrgMember(orgId) &&
        (teamId == '_club' || myOrgTeams(orgId).hasAny(['*']) || teamId in myOrgTeams(orgId));
    }

    /** Staff only reads; the club record is written only by who manages the club (owner, admin). */
    function memberWritesTeam(orgId, teamId) {
      return memberSeesTeam(orgId, teamId) &&
        myOrgRole(orgId) != 'staff' &&
        (teamId != '_club' || isOrgManager(orgId));
    }

    /** Invitations (D3): managers invite any role (not Administrador); a coordinator invites coaches and assistants;
     *  a coach invites assistants and staff; always for a team they see. */
    function memberInvites(orgId, role, teamId) {
      return isActiveOrgMember(orgId) && teamId != '_club' && memberSeesTeam(orgId, teamId) && (
        myOrgRole(orgId) in ['owner', 'admin'] ||
        (myOrgRole(orgId) == 'coordenador' && role in ['Treinador Principal', 'Treinador Adjunto']) ||
        (myOrgRole(orgId) == 'treinador' &&
          role in ['Treinador Adjunto', 'Treinador de Guarda-Redes', 'Preparador Físico', 'Analista', 'Fisioterapeuta'])
      );
    }

    // ---------- F2.8: the team's sheet ("Base de dados da equipa") and the phones for notices ----------

    /** The club a team sheet belongs to (its top document), or null when it has none yet. */
    function teamDbClub(teamId) {
      return exists(/databases/$(database)/documents/team_databases/$(teamId))
        ? get(/databases/$(database)/documents/team_databases/$(teamId)).data.get('clubId', null)
        : null;
    }

    /** The organization of a sheet. Old sheets say 'default' or (by an old mistake) the team's age group, never a
     *  club: those are the shared space 'main'. */
    function teamDbOrg(clubId) {
      return exists(orgPath(clubId)) ? clubId : 'main';
    }

    /** Whether the account already has a membership in its own club (then the old access no longer applies). */
    function hasOwnMembership() {
      let acc = getUserAccount();
      return acc != null && hasOrgMembership(acc.get('defaultOrgId', acc.get('clubId', 'main')));
    }

    /** With a membership in the sheet's club the membership decides (as for the records); otherwise the old access,
     *  only for accounts that have no membership yet (until F1.10). */
    function readsTeamDb(teamId, clubId) {
      return isMasterAdmin() || (
        clubId is string && hasOrgMembership(teamDbOrg(clubId))
          ? memberSeesTeam(teamDbOrg(clubId), teamId)
          : isTeamMember(teamId) && !hasOwnMembership()
      );
    }

    function writesTeamDb(teamId, clubId) {
      return isMasterAdmin() || (
        clubId is string && hasOrgMembership(teamDbOrg(clubId))
          ? memberWritesTeam(teamDbOrg(clubId), teamId)
          : canEditTeamDatabase(teamId) && !hasOwnMembership()
      );
    }

    /** Everyone's phones: who can send notices (an active member that is not staff), or the old access. */
    function readsPushSubscriptions(workspaceId) {
      return isMasterAdmin() ||
        (isActiveOrgMember(workspaceId) && myOrgRole(workspaceId) != 'staff') ||
        (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId));
    }

    function canAccessClubWorkspace(workspaceId) {
      return isAuthenticated() && (
        isMasterAdmin() ||
        // F1.3: an active member of the organization (its data lives in club_workspace/{orgId})
        isActiveOrgMember(workspaceId) ||
        // F2.3: the old access only for who has NO membership there (a suspended or revoked member has none)
        (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId))
      );
    }

    /** The access before organizations (club in the account, or "main"): kept until the strict rules v3. */
    function legacyClubAccess(workspaceId) {
      return isAuthenticated() && (
        (isApprovedUser() && (
          // Exact match with user's assigned clubId
          (getUserClubId() != null && workspaceId == getUserClubId()) ||
          // Default legacy workspace fallback for users who haven't yet been assigned a custom clubId
          (getUserClubId() == null && (workspaceId == 'main' || workspaceId == 'default')) ||
          // If the resource document has an explicit clubId property matching the user's clubId
          (resource != null && resource.data.keys().hasAny(['clubId']) && resource.data.clubId == getUserClubId())
        ))
      );
    }

    // ---- Invitations ----
    function invitationDoc(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    // An invitation that can still be used: exists, pending and not expired.
    function isUsableInvitation(code) {
      return code is string && code.size() > 0 && code.size() <= 64 &&
        exists(invitationDoc(code)) &&
        get(invitationDoc(code)).data.status == 'pending' &&
        get(invitationDoc(code)).data.expiresAt > request.time.toMillis();
    }

    // A new account may start "approved" only through a usable invitation, and exactly with what the invitation
    // grants: same club, the invited team only, the invited role (never Administrador) and the invited email.
    function isInvitedRegistration(acc) {
      let code = acc.get('inviteCode', '');
      let inv = get(invitationDoc(code)).data;
      return isUsableInvitation(code) &&
        acc.role == inv.role && acc.role != 'Administrador' &&
        acc.get('clubId', null) == inv.clubId &&
        acc.get('assignedTeams', []) == [inv.teamId] &&
        (acc.get('teamRoles', []).size() == 0 ||
          (acc.teamRoles.size() == 1 && acc.teamRoles[0].teamId == inv.teamId && acc.teamRoles[0].role == inv.role)) &&
        (inv.get('email', '') == '' || request.auth.token.email == inv.email);
    }

    // Who invites must belong to the club the invitation is for (the Administrator can invite to any club).
    function isOwnClub(clubId) {
      return clubId == getUserClubId() || (getUserClubId() == null && clubId == 'main');
    }

    function isValidUserDoc(data) {
      return data is map && 
        data.keys().hasAll(['account']) && 
        data.account is map && 
        data.account.keys().hasAll(['id', 'username', 'role', 'status']) && 
        data.account.id is string && data.account.id.size() <= 128 && 
        data.account.username is string && data.account.username.size() <= 80 && 
        data.account.role is string && data.account.role.size() <= 60 && 
        data.account.status is string && data.account.status in ['pending', 'approved', 'rejected'];
    }

    /**
     * Validates club and team workspace payloads to prevent denial-of-wallet,
     * document bloat, type mismatch, and corrupt timestamp attacks.
     *
     * Justificativa dos limites de tamanho:
     * - data.size() <= 20: O documento raiz armazena apenas 'state', 'updatedAt', 'lastUpdatedBy', 'lastUpdatedByName'
     *   e metadados opcionais de sincronização (versão, clientTimestamp). 20 chaves protegem contra poluição na raiz.
     * - data.state.size() <= 50: AppState contém atualmente ~20 propriedades de topo. O limite de 50 previne mapas
     *   de estado inflacionados permitindo margem saudável para evolução da aplicação.
     * - Listas de topo (roster <= 250, matches <= 350, trainings <= 600, schedule <= 350, tactics <= 150, teams <= 50):
     *   Uma época desportiva típica tem 20-30 atletas, ~35 jogos e ~120 treinos. Estes limites suportam histórico
     *   multi-anual e escalões múltiplos sem permitir injeções de dezenas de milhares de registos maliciosos.
     * - Strings (clubName <= 200, category <= 100, season <= 50): Suficiente para nomes desportivos completos.
     * - updatedAt: Impede timestamps negativos ou no futuro distante (margem de 10 min / 600.000 ms para desvio de relógio).
     */
    function isValidClubWorkspace(data) {
      return data is map && 
        data.size() <= 20 &&
        data.keys().hasAll(['state', 'updatedAt']) && 
        data.state is map && 
        data.state.size() <= 50 &&
        data.updatedAt is number &&
        data.updatedAt >= 0 &&
        data.updatedAt <= (request.time.toMillis() + 600000) &&
        (!data.state.keys().hasAny(['roster']) || (data.state.roster is list && data.state.roster.size() <= 250)) &&
        (!data.state.keys().hasAny(['matches']) || (data.state.matches is list && data.state.matches.size() <= 350)) &&
        (!data.state.keys().hasAny(['trainings']) || (data.state.trainings is list && data.state.trainings.size() <= 600)) &&
        (!data.state.keys().hasAny(['schedule']) || (data.state.schedule is list && data.state.schedule.size() <= 350)) &&
        (!data.state.keys().hasAny(['tactics']) || (data.state.tactics is list && data.state.tactics.size() <= 150)) &&
        (!data.state.keys().hasAny(['teams']) || (data.state.teams is list && data.state.teams.size() <= 50)) &&
        (!data.state.keys().hasAny(['staffMembers']) || (data.state.staffMembers is list && data.state.staffMembers.size() <= 50)) &&
        (!data.state.keys().hasAny(['myClubName']) || (data.state.myClubName is string && data.state.myClubName.size() <= 200)) &&
        (!data.state.keys().hasAny(['clubName']) || (data.state.clubName is string && data.state.clubName.size() <= 200)) &&
        (!data.state.keys().hasAny(['category']) || (data.state.category is string && data.state.category.size() <= 100)) &&
        (!data.state.keys().hasAny(['exerciseLibrary']) || (data.state.exerciseLibrary is list && data.state.exerciseLibrary.size() <= 200)) &&
        (!data.state.keys().hasAny(['season']) || (data.state.season is string && data.state.season.size() <= 50));
    }

    // Per-record club storage (one document per player, match, training, scheduled game, staff message,
    // scouting report, training exercise, set piece and tactics-board play, plus the "club" document with settings and the team list).
    function isValidClubRecord(data) {
      return data is map &&
        data.size() <= 10 &&
        data.keys().hasAll(['kind', 'teamId', 'entityId', 'updatedAt', 'deleted']) &&
        data.keys().hasOnly(['kind', 'teamId', 'entityId', 'updatedAt', 'updatedBy', 'deleted', 'data']) &&
        data.kind in ['club', 'player', 'match', 'training', 'schedule', 'message', 'scouting', 'exercise', 'setpiece', 'tacticplay', 'teamphoto', 'report', 'teamconfig'] &&
        data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 128 &&
        data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 256 &&
        data.updatedAt is number &&
        data.updatedAt >= 0 &&
        data.updatedAt <= (request.time.toMillis() + 600000) &&
        data.deleted is bool &&
        (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        (data.deleted == true || data.data is map);
    }

    // Calendar for the parents: only games and trainings (dates, times, opponents, places), never athletes' data.
    function isValidPublicCalendar(data) {
      return data is map &&
        data.keys().hasAll(['clubId', 'teamId', 'events', 'updatedAt']) &&
        data.keys().hasOnly(['clubId', 'teamId', 'teamName', 'events', 'updatedAt']) &&
        data.clubId is string && data.clubId.size() > 0 && data.clubId.size() <= 128 &&
        data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 128 &&
        (!data.keys().hasAny(['teamName']) || (data.teamName is string && data.teamName.size() <= 200)) &&
        data.events is list && data.events.size() <= 600 &&
        data.updatedAt is number;
    }

    // Plan for the assistant coach: the next training's plan only (blocks, minutes, drawings; no athletes' data).
    function isValidPublicPlan(data) {
      return data is map &&
        data.keys().hasAll(['clubId', 'teamId', 'teamName', 'updatedAt']) &&
        data.keys().hasOnly(['clubId', 'teamId', 'teamName', 'color', 'plan', 'updatedAt']) &&
        data.clubId is string && data.clubId.size() > 0 && data.clubId.size() <= 128 &&
        data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 128 &&
        data.teamName is string && data.teamName.size() <= 200 &&
        (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() <= 16)) &&
        (!data.keys().hasAny(['plan']) || data.plan == null || data.plan is map) &&
        data.updatedAt is number;
    }

    function isValidPublicLive(data) {
      return data is map &&
        data.keys().hasAll(['clubId', 'teamId', 'teamName', 'updatedAt']) &&
        data.keys().hasOnly(['clubId', 'teamId', 'teamName', 'color', 'game', 'next', 'updatedAt']) &&
        data.clubId is string && data.clubId.size() > 0 && data.clubId.size() <= 128 &&
        data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 128 &&
        data.teamName is string && data.teamName.size() <= 200 &&
        (!data.keys().hasAny(['color']) || (data.color is string && data.color.size() <= 16)) &&
        (!data.keys().hasAny(['game']) || data.game == null || data.game is map) &&
        (!data.keys().hasAny(['next']) || data.next == null || data.next is map) &&
        data.updatedAt is number;
    }

    function isValidPushSubscription(data) {
      return data is map &&
        data.keys().hasAll(['uid', 'endpoint', 'keys', 'prefs', 'teamIds', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'endpoint', 'keys', 'prefs', 'teamIds', 'updatedAt', 'device']) &&
        data.uid is string &&
        data.endpoint is string && data.endpoint.size() <= 1024 && data.endpoint.matches('^https://.*') &&
        data.keys is map && data.keys.keys().hasOnly(['p256dh', 'auth']) &&
        data.keys.p256dh is string && data.keys.p256dh.size() <= 256 &&
        data.keys.auth is string && data.keys.auth.size() <= 128 &&
        data.prefs is map && data.prefs.keys().hasOnly(['inicio', 'golo', 'fim']) &&
        data.teamIds is list && data.teamIds.size() <= 20 &&
        (!data.keys().hasAny(['device']) || (data.device is string && data.device.size() <= 80)) &&
        data.updatedAt is number;
    }

    // "Jogador do jogo" vote for the parents: candidates are shown by first name + initial and shirt number only.
    function isValidMvpPoll(data) {
      return data is map &&
        data.keys().hasAll(['clubId', 'teamId', 'title', 'candidates', 'candidateIds', 'open', 'closesAt', 'createdAt']) &&
        data.keys().hasOnly(['clubId', 'teamId', 'title', 'candidates', 'candidateIds', 'open', 'closesAt', 'createdAt']) &&
        data.clubId is string && data.clubId.size() > 0 && data.clubId.size() <= 128 &&
        data.teamId is string && data.teamId.size() > 0 && data.teamId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.candidates is list && data.candidates.size() > 0 && data.candidates.size() <= 30 &&
        data.candidateIds is list && data.candidateIds.size() == data.candidates.size() &&
        data.open is bool &&
        data.closesAt is number && data.createdAt is number;
    }

    // --- Collection Security Rules ---

    // Shareable calendar (Agenda → "Calendário para os pais"): the document id is a secret token of 24 random
    // characters. Anyone with the link reads that one document (no listing); only the club's approved coaches
    // write it or switch it off (same access as the club's workspace, including the default "main" club).
    match /public_calendars/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if isValidId(token) && token.size() >= 20 &&
        isValidPublicCalendar(incoming()) && canAccessClubWorkspace(incoming().clubId);
      allow update: if canAccessClubWorkspace(resource.data.clubId) &&
        isValidPublicCalendar(incoming()) && incoming().clubId == resource.data.clubId;
      allow delete: if canAccessClubWorkspace(resource.data.clubId);
    }

    // Plan for the assistant coach (Treinos → "Link para o adjunto"): same model as the shareable calendar. Anyone
    // with the secret link reads that one document; only the club's approved coaches write it or switch it off.
    match /public_plans/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if isValidId(token) && token.size() >= 20 &&
        isValidPublicPlan(incoming()) && canAccessClubWorkspace(incoming().clubId);
      allow update: if canAccessClubWorkspace(resource.data.clubId) &&
        isValidPublicPlan(incoming()) && incoming().clubId == resource.data.clubId;
      allow delete: if canAccessClubWorkspace(resource.data.clubId);
    }

    // 📡 Parents' live link (Mais → "Link do jogo para os pais"): same model as the assistant's plan. Anyone with the
    // secret link reads that one document (the game, without substitutions); only the club's coaches write it.
    match /public_lives/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if isValidId(token) && token.size() >= 20 &&
        isValidPublicLive(incoming()) && canAccessClubWorkspace(incoming().clubId);
      allow update: if canAccessClubWorkspace(resource.data.clubId) &&
        isValidPublicLive(incoming()) && incoming().clubId == resource.data.clubId;
      allow delete: if canAccessClubWorkspace(resource.data.clubId);
    }

    // Parents' vote for the "Jogador do jogo" (Resultados → ⭐): the poll id is a secret token. Anyone with the link
    // reads the poll and casts ONE anonymous ballot per device (the ballot id is a random id kept on the phone; a
    // ballot is never changed). Only the club's approved coaches create/close the poll and read the ballots.
    match /public_votes/{token} {
      allow get: if token.size() >= 20;
      allow list: if false;
      allow create: if isValidId(token) && token.size() >= 20 &&
        isValidMvpPoll(incoming()) && canAccessClubWorkspace(incoming().clubId);
      allow update: if canAccessClubWorkspace(resource.data.clubId) &&
        isValidMvpPoll(incoming()) && incoming().clubId == resource.data.clubId;
      allow delete: if canAccessClubWorkspace(resource.data.clubId);

      match /ballots/{voterId} {
        allow create: if isValidId(voterId) && voterId.size() >= 16 && voterId.size() <= 64 &&
          incoming().keys().hasOnly(['candidate']) &&
          incoming().candidate is string &&
          get(/databases/$(database)/documents/public_votes/$(token)).data.open == true &&
          request.time.toMillis() < get(/databases/$(database)/documents/public_votes/$(token)).data.closesAt &&
          incoming().candidate in get(/databases/$(database)/documents/public_votes/$(token)).data.candidateIds;
        allow get, list: if
          canAccessClubWorkspace(get(/databases/$(database)/documents/public_votes/$(token)).data.clubId);
        allow update, delete: if false;
      }
    }

    // Dedicated Admins Collection
    match /admins/{adminId} {
      allow read: if isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    // User accounts collection
    match /users/{userId} {
      // Individual user profile reading: own profile, the Administrator, or an approved member of the SAME club
      allow get: if isAuthenticated() && (
        isMasterAdmin() ||
        isOwner(userId) ||
        (isApprovedUser() && resource.data.account.get('clubId', null) == getUserClubId())
      );

      // Listing user profiles (approval dashboard) is reserved to the Administrator: it would expose the
      // names, emails and phones of every club.
      allow list: if isMasterAdmin();

      // Self registration (pending status, non-admin role, empty teams) or Master Admin creation
      allow create: if isAuthenticated() && 
        isValidId(userId) && 
        isValidUserDoc(incoming()) && (
          isMasterAdmin() ||
          (isOwner(userId) &&
           incoming().account.status == 'pending' &&
           incoming().account.role != 'Administrador' &&
           (!incoming().account.keys().hasAny(['assignedTeams']) || incoming().account.assignedTeams.size() == 0)) ||
          (isOwner(userId) &&
           incoming().account.status == 'approved' &&
           isInvitedRegistration(incoming().account))
        );

      // Updates: Master Admin can update anything; regular approved owner can update non-critical profile fields only
      // A regular coach is FORBIDDEN from elevating role, status, clubId, or assigned teams
      allow update: if isAuthenticated() && 
        isValidId(userId) && 
        isValidUserDoc(incoming()) && (
          isMasterAdmin() || 
          (isOwner(userId) && 
           isApprovedUser() && 
           incoming().account.role == existing().account.role &&
           incoming().account.status == existing().account.status &&
           incoming().account.get('assignedTeams', []) == existing().account.get('assignedTeams', []) &&
           incoming().account.get('teamRoles', []) == existing().account.get('teamRoles', []) &&
           incoming().account.get('clubId', null) == existing().account.get('clubId', null))
        );

      // Only Master Admin can delete accounts
      allow delete: if isMasterAdmin();
    }

    // Shared Master Club Database (tactics, squad, matches, trainings, schedule)
    match /club_workspace/{workspaceId} {
      // F2.3: the old single document holds EVERY team's data: only who manages the club (and who has no
      // membership yet, with the old access)
      allow get, list: if isMasterAdmin() || isOrgManager(workspaceId) ||
        (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId));
      
      allow create, update: if (isMasterAdmin() || isOrgManager(workspaceId) ||
          (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId))) &&
        isValidId(workspaceId) && 
        isValidClubWorkspace(incoming());
      
      allow delete: if isMasterAdmin();

      match /records/{recordId} {
        // F2.3: a member reads only the club record and the records of their teams
        allow get, list: if isMasterAdmin() ||
          memberSeesTeam(workspaceId, resource.data.teamId) ||
          (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId));
        // …and writes only their teams (staff never; the club record only who manages the club). A record never
        // moves to another team.
        allow create, update: if isValidId(recordId) &&
          isValidClubRecord(incoming()) && (
            isMasterAdmin() ||
            (memberWritesTeam(workspaceId, incoming().teamId) &&
              (resource == null || resource.data.teamId == incoming().teamId)) ||
            (!hasOrgMembership(workspaceId) && legacyClubAccess(workspaceId))
          );
        // Records are deleted with tombstones (deleted: true); hard deletes only by the Administrator.
        allow delete: if isMasterAdmin();
      }

      // 🔔 Avisos do jogo: the phones where each coach wants the notices of the club's games (a Web Push
      // subscription: an address of the phone's push service and its keys, no personal data). Every coach of the club
      // reads them (the app's server sends the notices with the sender's sign-in); each one writes only their own.
      match /push_subscriptions/{subId} {
        // F2.8: everyone reads their own phones; the list of everyone's phones only who can send notices (not staff)
        allow get, list: if readsPushSubscriptions(workspaceId) ||
          (canAccessClubWorkspace(workspaceId) && resource.data.uid == request.auth.uid);
        allow create, update: if canAccessClubWorkspace(workspaceId) &&
          isValidId(subId) &&
          isValidPushSubscription(incoming()) &&
          incoming().uid == request.auth.uid &&
          (resource == null || resource.data.uid == request.auth.uid);
        // A coach removes their own phone; the server removes phones the push service no longer knows
        allow delete: if readsPushSubscriptions(workspaceId) ||
          (canAccessClubWorkspace(workspaceId) && resource.data.uid == request.auth.uid);
      }
    }

    // Team-isolated workspaces (Enforced per-team access control)
    match /team_workspaces/{workspaceId} {
      allow get, list: if canAccessTeamWorkspace(workspaceId);
      
      allow create, update: if canAccessTeamWorkspace(workspaceId) && 
        isValidId(workspaceId) && 
        isValidClubWorkspace(incoming());
      
      allow delete: if isMasterAdmin();
    }

    // Team-isolated custom spreadsheet databases (Excel datasets and rows)
    match /team_databases/{teamId} {
      allow get, list: if readsTeamDb(teamId, resource == null ? null : resource.data.get('clubId', null));
      // The club of a sheet only changes by someone who can write the sheet in its current club too
      allow create, update: if writesTeamDb(teamId, incoming().clubId) &&
        (resource == null || resource.data.get('clubId', null) == incoming().clubId ||
          writesTeamDb(teamId, resource.data.get('clubId', null))) &&
        isValidId(teamId) && isValidTeamDbMeta(incoming());
      allow delete: if isMasterAdmin();

      match /datasets/{datasetId} {
        allow get, list: if readsTeamDb(teamId, teamDbClub(teamId));
        allow create, update: if writesTeamDb(teamId, teamDbClub(teamId)) && isValidId(datasetId) && isValidTeamDataset(incoming());
        // Elimination of an entire dataset is restricted to Administrator
        allow delete: if isMasterAdmin();

        match /rows/{rowId} {
          allow get, list: if readsTeamDb(teamId, teamDbClub(teamId));
          allow create, update: if writesTeamDb(teamId, teamDbClub(teamId)) && isValidId(rowId) && isValidTeamDbRow(incoming());
          // Elimination of individual rows can be performed by coaches/editors
          allow delete: if writesTeamDb(teamId, teamDbClub(teamId));
        }
      }
    }

    // Multi-tenant club subcollections: clubs/{clubId}/...
    match /clubs/{clubId} {
      allow get, list: if canAccessClubWorkspace(clubId);
      allow create, update: if canAccessClubWorkspace(clubId) && isValidId(clubId);
      allow delete: if isMasterAdmin();

      match /{subcollection}/{docId} {
        allow get, list: if canAccessClubWorkspace(clubId);
        allow create, update: if canAccessClubWorkspace(clubId) && isValidId(docId);
        allow delete: if isMasterAdmin();
      }
    }

    // Immutable Audit Logs (Append-only security guarantee)
    match /audit_logs/{logId} {
      allow get: if isMasterAdmin() || (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid);
      allow list: if isMasterAdmin();
      allow create: if isAuthenticated() && 
        isValidId(logId) && 
        (isMasterAdmin() || (incoming().keys().hasAny(['userId']) && incoming().userId == request.auth.uid));
      // Absolute immutability: no updates or deletions allowed by anyone
      allow update, delete: if false;
    }

    // Staff and Team Invitations
    match /invitations/{invitationId} {
      // Opened by its code, also before having an account (registration form); only while usable.
      allow get: if isMasterAdmin() ||
        (resource.data.status == 'pending' && resource.data.expiresAt > request.time.toMillis()) ||
        (isApprovedUser() && isOwnClub(resource.data.clubId));
      allow list: if isMasterAdmin();

      // Created by an approved member, for their own club, as themselves, never for the Administrador role.
      allow create: if isValidId(invitationId) &&
        incoming().status == 'pending' &&
        incoming().role != 'Administrador' &&
        incoming().invitedBy == request.auth.uid && (
          isMasterAdmin() ||
          // F2.3: a member of the organization invites by role and only for their teams (D3)
          (hasOrgMembership(incoming().clubId) &&
            memberInvites(incoming().clubId, incoming().role, incoming().teamId)) ||
          (!hasOrgMembership(incoming().clubId) && isApprovedUser() && isOwnClub(incoming().clubId))
        );

      // Revoked by the Administrador or a member of the same club; accepted once by the invited new account.
      allow update: if isMasterAdmin() ||
        (isApprovedUser() && isOwnClub(existing().clubId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status == 'revoked') ||
        (isAuthenticated() &&
          existing().status == 'pending' &&
          incoming().status == 'accepted' &&
          incoming().usedBy == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedBy', 'acceptedAt']) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.account.get('inviteCode', '') == invitationId);
      allow delete: if isMasterAdmin();
    }

    // ---- F1.3: organizations, their members and their audit ----
    match /organizations/{orgId} {
      // Its members, its owner (also while pending) and the platform Administrator read it; only the Administrator lists
      allow get: if isMasterAdmin() || isActiveOrgMember(orgId) ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow list: if isMasterAdmin();
      // Anyone signed in creates their OWN organization, waiting for approval (manual approval during the pilot)
      allow create: if isValidOrganization(orgId, incoming()) && (
        isMasterAdmin() ||
        (isAuthenticated() &&
          incoming().ownerUid == request.auth.uid &&
          incoming().createdBy == request.auth.uid &&
          incoming().status == 'pending' &&
          // Never the id of a club that already has data (e.g. "main"): that would hand its data to a stranger
          // once approved by mistake
          !exists(/databases/$(database)/documents/club_workspace/$(orgId)) &&
          orgId != 'main' && orgId != 'default')
      );
      // The Administrator approves or suspends; the owner/admin change only the name and the logo
      allow update: if isValidOrganization(orgId, incoming()) && (
        isMasterAdmin() ||
        (isOrgManager(orgId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'shortName', 'logoUrl']))
      );
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isMasterAdmin() || (isAuthenticated() && request.auth.uid == memberUid) || isActiveOrgMember(orgId);
        allow list: if isMasterAdmin() || isActiveOrgMember(orgId);
        allow create: if isValidOrgMember(memberUid, incoming()) && incoming().addedBy == request.auth.uid && (
          isMasterAdmin() ||
          // The owner as first member, in the same write that creates their pending organization
          (isAuthenticated() &&
            memberUid == request.auth.uid &&
            incoming().role == 'owner' &&
            incoming().status == 'active' &&
            !exists(orgPath(orgId)) &&
            getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid &&
            getAfter(orgPath(orgId)).data.status == 'pending') ||
          // An owner/admin adds a member: never an owner, never above their own role
          (isOrgManager(orgId) &&
            incoming().role != 'owner' &&
            roleRank(incoming().role) <= roleRank(myOrgRole(orgId)))
        );
        // Owner/admin change role, teams or status of the others (never the owner, never to owner or above them)
        allow update: if isValidOrgMember(memberUid, incoming()) && (
          isMasterAdmin() ||
          (isOrgManager(orgId) &&
            memberUid != request.auth.uid &&
            existing().role != 'owner' &&
            incoming().role != 'owner' &&
            roleRank(existing().role) <= roleRank(myOrgRole(orgId)) &&
            roleRank(incoming().role) <= roleRank(myOrgRole(orgId)) &&
            incoming().addedBy == existing().addedBy &&
            incoming().addedAt == existing().addedAt)
        );
        // Access is taken away with status "revoked" (kept for the record), never by deleting
        allow delete: if false;
      }

      // Audit: only appended, by an active member (or the owner creating the organization), in their own name
      match /audit/{entryId} {
        allow get, list: if isMasterAdmin() || isOrgManager(orgId);
        allow create: if isAuthenticated() &&
          isValidId(entryId) &&
          incoming().keys().hasAll(['action', 'actorUid', 'at']) &&
          incoming().keys().hasOnly(['action', 'actorUid', 'targetUid', 'teamId', 'at', 'details']) &&
          incoming().actorUid == request.auth.uid &&
          incoming().action is string && incoming().action.size() <= 40 &&
          incoming().at is number &&
          (!incoming().keys().hasAny(['details']) || (incoming().details is map && incoming().details.size() <= 10)) &&
          (isMasterAdmin() ||
            (existsAfter(orgMemberPath(orgId, request.auth.uid)) &&
              getAfter(orgMemberPath(orgId, request.auth.uid)).data.status == 'active'));
        allow update, delete: if false;
      }
    }

    // System configurations & metadata
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isMasterAdmin();
    }
  }
}
